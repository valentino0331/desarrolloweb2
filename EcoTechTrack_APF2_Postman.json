        {
            "name": "4. Consigna 1 - Listar Activos RAEE Dados de Baja (JPA)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "url": {
                    "raw": "http://localhost:8080/api/expenses",
                    "protocol": "http",
                    "host": ["localhost"],
                    "port": "8080",
                    "path": ["api", "expenses"]
                }
            }
        },
