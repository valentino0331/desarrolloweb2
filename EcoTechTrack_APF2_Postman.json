                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"amount\": 18.50,\n  \"categoryName\": \"TIC - Equipos de Informática\",\n  \"subcategory\": \"Servidor Rack / Baterías Cadmio\",\n  \"description\": \"Servidor PowerEdge R720 dado de baja por obsolescencia. Contiene soldaduras con Plomo y baterías auxiliares con Cadmio (D.S. 009-2019-MINAM)\",\n  \"recurrence\": \"BAJA_DEFINITIVA\"\n}"
                },
